{
  "name": "web",
  "version": "1.0.0",
  "private": true,
  "description": "RedNote Clone 前端 SPA（React + Vite），同时作为 Android / Windows 客户端的宿主代码",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:native": "vite build --base=./ --mode native",
    "preview": "vite preview --port 4173",
    "sync": "npm run build:native && cap sync android",
    "open:android": "cap open android"
  },
  "dependencies": {
    "@capacitor/core": "^7.4.3",
    "@capacitor/app": "^7.1.0",
    "@capacitor/haptics": "^7.0.2",
    "@capacitor/status-bar": "^7.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/cli": "^7.4.3",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.19"
  }
}
