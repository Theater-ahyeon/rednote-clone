{
  "name": "rednote-clone",
  "version": "1.0.0",
  "private": true,
  "description": "高保真仿小红书（RED / RedNote）全栈应用：Web + Android + Windows 三端一体",
  "license": "MIT",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace web",
    "start": "npm run start --workspace server",
    "seed": "npm run seed --workspace server",
    "reset": "npm run seed --workspace server -- --reset",
    "test": "npm test --workspace server",
    "android:sync": "npm run sync --workspace web",
    "android:open": "npm run open:android --workspace web",
    "desktop": "cd desktop && npm install && npm start",
    "docs:shot": "node scripts/screenshot.js"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "devDependencies": {
    "playwright-core": "^1.57.0"
  }
}
